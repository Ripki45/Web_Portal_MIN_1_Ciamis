# ==============================================================================
# KEAMANAN STORAGE UPLOAD MIN 1 CIAMIS: ANTI-WEB SHELL & BACKDOOR
# ==============================================================================
# Direktori ini hanya diperuntukkan bagi berkas statis (gambar, dokumen, pdf).
# Pengeksekusian skrip PHP atau bahasa pemrograman lain DILARANG KERAS.

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phar|phps|pl|py|cgi|sh|bash|exe|asp|aspx|jsp|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Matikan engine PHP jika Apache menggunakan mod_php
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Matikan browsing isi folder & CGI
Options -Indexes -ExecCGI
